# Playvo Web — environment variables (copy to .env.local to use locally).
#
# Backend (Laravel) host only, WITHOUT the /api/v1 prefix — the app adds it.
# Leave EMPTY until the backend team provides a confirmed URL: while it is
# empty the app uses the built-in mock authentication and sends no network
# requests. Do not guess a value (not Laravel's APP_URL, not a local port).
VITE_API_BASE_URL=
